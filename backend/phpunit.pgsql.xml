<?xml version="1.0" encoding="UTF-8"?>
<!--
  Доменные тесты на локальной PostgreSQL volley_test — запуск ТОЛЬКО через tools/test-pgsql.sh (см. docs/auto-quorum.md).
  Сюда НЕ включать тесты с RefreshDatabase/DatabaseMigrations (стандартные Jetstream): на pgsql они делают migrate:fresh
  и ломают тестовую БД. Доменные тесты — DatabaseTransactions (tests/Support/PgsqlTestCase).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Domain">
            <file>tests/Feature/RegistrationFlowTest.php</file>
            <file>tests/Feature/MatchStartTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- DB_* — из .env.testing (их экспортирует tools/test-pgsql.sh) -->
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="SENTRY_LARAVEL_DSN" value=""/>
    </php>
</phpunit>
