+def register_known_chat(chat_id: Any, added_by: Any = None) -> None:
+    cid = str(chat_id or "").strip()
+    if not cid or not cid.startswith("-"):
+        return
+    data = load_known_chats()
+    changed = False
+    if cid not in data:
+        data[cid] = {"added_at": int(time.time())}
+        changed = True
+        log_message(f"KNOWN CHAT ADDED: {cid} added_by={added_by}")
+    if added_by and str(data[cid].get("added_by") or "") != str(added_by):
+        data[cid]["added_by"] = str(added_by)   # кто добавил бота — тот видит чат в списке привязки
+        changed = True
+    if changed:
+        save_known_chats(data)
+
+
+def forget_known_chat(chat_id: Any) -> None:
+    cid = str(chat_id or "").strip()
+    data = load_known_chats()
+    if cid in data:
+        data.pop(cid, None)
+        save_known_chats(data)
+        log_message(f"KNOWN CHAT REMOVED: {cid}")
+
