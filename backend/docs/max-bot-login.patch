+def _login_backend(path: str, payload: dict[str, Any]) -> dict[str, Any]:
+    """Вход через MAX: шаги begin/code на бэкенде (тексты ответов отдаёт сервер)."""
+    resp = requests.post(
+        f"{BACKEND_URL}/api/integrations/max/login/{path}",
+        headers={
+            "X-Bind-Secret": BIND_WEBHOOK_SECRET,
+            "Accept": "application/json",
+            "Content-Type": "application/json",
+        },
+        json=payload,
+        timeout=20,
+    )
+    resp.raise_for_status()
+    return resp.json()
+
